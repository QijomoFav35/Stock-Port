# Copy this file to .env.local and fill in. Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_BASE_BUILDER_CODE=        # dashboard.base.org → Settings → Builder Code (bc_xxxxxxxx)
NEXT_PUBLIC_BASE_RPC_URL=             # optional; e.g. Alchemy Base mainnet URL. Defaults to public RPC.
NEXT_PUBLIC_BASKET=NVDAc:3400,GOOGLc:3300,METAc:3300   # SYMBOL:bps, must sum to 10000
NEXT_PUBLIC_MAX_PORT_USDC=500

# Server only (Vercel env vars, never NEXT_PUBLIC_)
# Stock buys go straight to Aerodrome on Base: no key needed.
ZEROX_API_KEY=                        # dashboard.0x.org (free). Needed for Dust to Stocks; also backup for stock buys
ALCHEMY_API_KEY=                      # dashboard.alchemy.com (free). Dust to Stocks wallet scan
SWAP_PROVIDER=aerodrome               # aerodrome (default), 0x or o1
O1_API_KEY=                           # optional, only if we add o1 back later
BANKR_API_KEY=                        # Phase 3 agent
SUPABASE_URL=                         # Phase 3
SUPABASE_SERVICE_ROLE_KEY=            # Phase 3

# Local testing only: pretend to be in this country (e.g. US to test the block)
GEO_OVERRIDE_COUNTRY=
