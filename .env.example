# Copy this file to .env.local and fill in. Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_BASE_BUILDER_CODE=        # dashboard.base.org → Settings → Builder Code (bc_xxxxxxxx)
NEXT_PUBLIC_BASKET=NVDAc:3400,GOOGLc:3300,METAc:3300   # SYMBOL:bps, must sum to 10000
NEXT_PUBLIC_MAX_PORT_USDC=500
NEXT_PUBLIC_SITE_URL=                 # your live address once deployed, e.g. https://your-app.onrender.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= # optional; dashboard.reown.com (free). Adds a QR code for phone wallets
NEXT_PUBLIC_NAV_DRIFT_MAX_PCT=2       # buys pause when a pool is more than this % off its Chainlink NAV. 0 = guard off
NEXT_PUBLIC_GASLESS=                  # 1 = ask smart wallets (Base Account) to sponsor gas via /api/paymaster. Needs CDP_PAYMASTER_URL
NEXT_PUBLIC_LOAN_GUARD_ADDRESS=       # LoanGuard contract after deploying (localhost:3000/deploy-guard)
NEXT_PUBLIC_LOAN_GUARD_FROM_BLOCK=    # block it was deployed in
NEXT_PUBLIC_GUARD_PREVIEW=            # local only: 1 = show Loan Guard with sample data. Never set on Render
NEXT_PUBLIC_CONTACT_X=                # your project's X handle without @, shown in the footer and /privacy
NEXT_PUBLIC_CONTACT_EMAIL=            # optional project inbox (not a personal address)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=         # optional cookieless analytics (cloud.umami.is, free)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=         # optional alternative to Umami

# Server only (never NEXT_PUBLIC_)
# Stock buys go straight to Aerodrome on Base: no key needed.
BASE_RPC_URL=                         # e.g. https://base-mainnet.g.alchemy.com/v2/KEY. The browser reads through /api/rpc, so this key is never public. Empty = public RPC (rate-limited)
ZEROX_API_KEY=                        # dashboard.0x.org (free). Needed for Dust to Stocks; also backup for stock buys
ALCHEMY_API_KEY=                      # dashboard.alchemy.com (free). Dust to Stocks wallet scan
SWAP_PROVIDER=o1                      # o1 first (partner track); Aerodrome is the automatic fallback and serves Base Account users
O1_API_KEY=                           # o1.exchange/api-trading
CDP_PAYMASTER_URL=                    # optional; portal.cdp.coinbase.com → Paymaster → Base mainnet URL. Server only, never NEXT_PUBLIC_
BANKR_API_KEY=                        # Phase 3 agent
KEEPER_PRIVATE_KEY=                   # Loan Guard keeper: a FRESH wallet with ~$2 of ETH for gas only. Never your main wallet
KEEPER_CRON_SECRET=                   # 32+ random chars: openssl rand -hex 32. The cron job sends it as Authorization: Bearer ...

# US block on any host (see lib/geo.ts). On Render use ipinfo: free token at ipinfo.io/signup
GEO_SOURCE=                           # vercel | cloudflare | ipinfo (auto if empty)
IPINFO_TOKEN=

# Local testing only: pretend to be in this country (e.g. US to test the block)
GEO_OVERRIDE_COUNTRY=
